# ===========================================================================
# Multilingual file for the TOS 7 Docker application "openwebuidocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Open WebUI"
auth         = "open-webui"
version      = "@@VERSION@@"
descript     = "Open WebUI is a self-hosted chat interface for local and remote models: talk to Ollama or any OpenAI-compatible API, keep per-user chats, use prompts, documents (RAG), web search and tools, and manage users from the admin panel. Its database, uploads and vector store stay in the application data folder."
release_note = "1. First release: Open WebUI 0.13.3 from Docker Hub as a non-root container. Self-hosted chat UI for Ollama/OpenAI-compatible backends with RAG and tools; data in the application data folder."
important    = "Requires DockerEngine (installed automatically if missing). Create the admin account on first run; then connect a model backend in Settings - an Ollama instance on your network or an OpenAI-compatible API with its key. Data (SQLite, uploads, vector store) lives in DockerAppData/openwebuidocker/data. The image is large, expect a longer first start. Plain HTTP; use a TLS reverse proxy before exposing it to the internet."

[zh-cn]
name         = "Open WebUI"
auth         = "open-webui"
version      = "@@VERSION@@"
descript     = "Open WebUI 是自建的聊天界面，可接本地或远程模型：连接 Ollama 或任何 OpenAI 兼容 API，保存按用户的对话，支持提示词、文档（RAG）、联网搜索与工具，并能在管理面板里管理用户。数据库、上传文件与向量库都保存在应用数据目录。"
release_note = "1. 首个版本：基于 Docker Hub 的 Open WebUI 0.13.3，以非 root 容器运行。自建聊天界面，支持 Ollama/OpenAI 兼容后端、RAG 与工具；数据保存在应用数据目录。"
important    = "需要 DockerEngine（缺失时应用中心会自动安装）。首次运行请创建管理员账号，然后在设置里接入模型后端——网络里的 Ollama 或带 Key 的 OpenAI 兼容 API。数据（SQLite、上传、向量库）保存在 DockerAppData/openwebuidocker/data。镜像较大，首次启动会久一些。界面为纯 HTTP，暴露到公网前请配置带 TLS 的反向代理。"

[zh-hk]
name         = "Open WebUI"
auth         = "open-webui"
version      = "@@VERSION@@"
descript     = "Open WebUI 是自建的聊天介面，可接本機或遠端模型：連接 Ollama 或任何 OpenAI 相容 API，保存按使用者的對話，支援提示詞、文件（RAG）、聯網搜尋與工具，並能在管理面板裡管理使用者。資料庫、上傳檔案與向量庫都保存在應用資料目錄。"
release_note = "1. 首個版本：基於 Docker Hub 的 Open WebUI 0.13.3，以非 root 容器運行。自建聊天介面，支援 Ollama/OpenAI 相容後端、RAG 與工具；資料保存在應用資料目錄。"
important    = "需要 DockerEngine（缺少時應用中心會自動安裝）。首次執行請建立管理員帳號，然後在設定裡接入模型後端——網路裡的 Ollama 或帶 Key 的 OpenAI 相容 API。資料（SQLite、上傳、向量庫）保存在 DockerAppData/openwebuidocker/data。映像較大，首次啟動會久一些。介面為純 HTTP，公開到互聯網前請配置帶 TLS 的反向代理。"

